[Unit]
Description=Nginx performance agent (pull mail, report, push to Weixin)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workplace/auto-fix
Environment=PYTHONUNBUFFERED=1
# hermes lives in ~/.local/bin, which is not on the default service PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workplace/auto-fix/.venv/bin/nginx-perf-agent fetch-report
StandardOutput=journal
StandardError=journal
