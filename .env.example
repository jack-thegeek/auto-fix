# Copy to .env and adjust. All variables are optional; defaults are shown.

# Logging
NPA_LOG_LEVEL=INFO
NPA_LOG_JSON=false

# Where downloaded logs, extracted archives and reports are stored
NPA_DATA_DIR=data

# SQLite database (SQLAlchemy URL)
NPA_DATABASE_URL=sqlite:///data/nginx_perf.db

# IMAP mailbox (required by mail-test, process and watch)
NPA_IMAP_HOST=
NPA_IMAP_PORT=993
NPA_IMAP_SSL=true
NPA_IMAP_USER=
# Never commit the real password; it is masked in logs and CLI output
NPA_IMAP_PASSWORD=
NPA_IMAP_MAILBOX=INBOX
# Only emails whose subject contains this text are processed
NPA_IMAP_SUBJECT_FILTER=Nginx 日志
# Seconds between polling passes in `watch`
NPA_IMAP_POLL_INTERVAL=300
# Connection retries per IMAP operation and backoff base in seconds
NPA_IMAP_MAX_RETRIES=3
NPA_IMAP_RETRY_DELAY=2

# Archives expanding beyond this size are rejected (bytes)
NPA_MAX_ATTACHMENT_BYTES=268435456
